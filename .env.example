# Copy this file to .env.local and fill in your key.
# Get a free Google Gemini API key at https://aistudio.google.com/apikey — it is only read on
# the server (app/api/ai/route.ts) and is never sent to the browser.
# Do NOT prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: use a different Gemini model (default: gemini-3.8-flash, falls back to
# gemini-3.5-flash-lite when rate-limited). Check the free tier before changing it:
# https://ai.google.dev/gemini-api/docs/pricing
# GEMINI_MODEL=gemini-3.5-flash-lite
