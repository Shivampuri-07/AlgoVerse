# Copy this file to .env.local for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables (separate values for Development / Preview /
# Production). Never commit real values. Never paste secrets into chat.

# ── Google Gemini (AI helper) ─────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey — it is only read on the server
# (app/api/ai/route.ts) and is never sent to the browser. Do NOT prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: use a different Gemini model (default: gemini-3.8-flash, falls back to
# gemini-3.5-flash-lite when rate-limited). Check the free tier before changing it:
# https://ai.google.dev/gemini-api/docs/pricing
# GEMINI_MODEL=gemini-3.5-flash-lite

# ── Firebase web app (PUBLIC — identifies the project, not a secret) ──────────────────────
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and
# configuration ("Config"). Leave empty to run AlgoVerse without accounts (local-only).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SECRET — server only) ─────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file content on one line (or its base64 encoding). Never prefix it
# with NEXT_PUBLIC_, never commit it, and never paste it into chat.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Local emulators (development only; never set these on Vercel) ────────────────────────
# With `npx firebase-tools emulators:start --project demo-algoverse` running, uncomment to use
# the local Auth/Firestore emulators instead of the real project (no credentials needed):
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-algoverse
