{
  "name": "algoverse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --experimental-strip-types --no-warnings scripts/validate-a2z-data.ts",
    "test:ai": "node --experimental-strip-types --no-warnings --import ./scripts/tests/register.mjs --test scripts/tests/ai-route.test.ts",
    "test:sw": "node --test scripts/tests/sw.test.mjs",
    "test:videos": "node --experimental-strip-types --no-warnings --import ./scripts/tests/register.mjs --test scripts/tests/videos.test.ts",
    "test": "npm run test:ai && npm run test:sw && npm run test:videos && npm run test:auth-unit && npm run test:sync-unit && npm run test:billing-unit",
    "test:auth-unit": "node --experimental-strip-types --no-warnings --import ./scripts/tests/register.mjs --test scripts/tests/auth-unit.test.ts",
    "test:rules": "node --test scripts/tests/firestore-rules.test.mjs",
    "test:auth-emulator": "node --experimental-strip-types --no-warnings --import ./scripts/tests/register.mjs --test scripts/tests/auth-emulator.test.ts",
    "test:firebase": "npx -y firebase-tools@15.31.0 emulators:exec --only auth,firestore --project demo-algoverse \"npm run test:rules && npm run test:auth-emulator\"",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "test:e2e": "node scripts/tests/run-e2e.mjs",
    "test:billing-unit": "node --experimental-strip-types --no-warnings --import ./scripts/tests/register.mjs --test scripts/tests/billing-unit.test.ts",
    "test:sync-unit": "node --experimental-strip-types --no-warnings --import ./scripts/tests/register.mjs --test scripts/tests/sync-unit.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.441.0",
    "next": "^15.3.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
